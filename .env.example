# Copy this file to .env and fill in the values. Never commit .env.
# EXPO_PUBLIC_ values are built into the app, so only public identifiers go here, never secrets.

# Phase 2: Google Calendar export (OAuth client IDs from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
